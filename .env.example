# =============================================================================
# TravelPropose MVP — Variáveis de Ambiente
# =============================================================================
# Copiar para .env.local e preencher os valores reais.
# NUNCA commitar .env.local nem qualquer ficheiro com valores reais.
# Validação automática no arranque via lib/env.ts (Zod).
# =============================================================================

# --- Supabase (públicas — seguras para o browser) ---

# URL pública do projeto Supabase.
# Encontrar em: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública de acesso (anon key) do projeto Supabase.
# Encontrar em: Supabase Dashboard > Project Settings > API > Project API Keys > anon public
# Esta chave é protegida pelas políticas RLS — não concede acesso privilegiado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (exclusivas do servidor — nunca expor ao browser) ---

# Chave administrativa (service_role key) do projeto Supabase.
# Encontrar em: Supabase Dashboard > Project Settings > API > Project API Keys > service_role
# ATENÇÃO: ignora as políticas RLS. Usar apenas em Server Actions e Route Handlers seguros.
SUPABASE_SECRET_KEY=
